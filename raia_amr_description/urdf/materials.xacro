<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="chassis_grey">
        <color rgba="0.22 0.24 0.28 1.0"/>
    </material>

    <material name="accent_blue">
        <color rgba="0.12 0.35 0.70 1.0"/>
    </material>

    <material name="rack_metal">
        <color rgba="0.35 0.38 0.42 1.0"/>
    </material>

    <material name="wheel_black">
        <color rgba="0.10 0.10 0.10 1.0"/>
    </material>

    <material name="lidar_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
    </material>

    <material name="lens_red">
        <color rgba="0.85 0.10 0.10 1.0"/>
    </material>

    <material name="camera_blue">
        <color rgba="0.10 0.50 0.85 1.0"/>
    </material>

    <!-- Matériaux zone de recharge AMR -->
    <material name="charging_copper">
        <color rgba="0.85 0.55 0.20 1.0"/>
    </material>

    <material name="charging_green">
        <color rgba="0.10 0.90 0.20 1.0"/>
    </material>

    <material name="charging_pad_black">
        <color rgba="0.15 0.15 0.15 1.0"/>
    </material>

</robot>
