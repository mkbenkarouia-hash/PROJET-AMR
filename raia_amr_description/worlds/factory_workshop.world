        </visual>

        <!-- Logo MiR — Lettre R -->
        <visual name="mir_logo_r">
          <pose>-0.21 0.096 0.31 0 0 0</pose>
          <geometry><box><size>0.045 0.003 0.07</size></box></geometry>
          <material>
            <ambient>0.45 0.47 0.50 1</ambient>
            <diffuse>0.50 0.52 0.55 1</diffuse>
