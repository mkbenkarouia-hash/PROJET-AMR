          <geometry><box><size>0.22 0.11 0.12</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>

        <!-- Pantalon de travail d'atelier (Bleu de travail / Jean foncé) -->
        <visual name="worker_leg_left">
          <pose>0 0.11 0.48 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>0.72</length></cylinder></geometry>
          <material><ambient>0.15 0.20 0.35 1</ambient><diffuse>0.18 0.25 0.45 1</diffuse></material>
        </visual>
        <visual name="worker_leg_right">
          <pose>0 -0.11 0.48 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>0.72</length></cylinder></geometry>
          <material><ambient>0.15 0.20 0.35 1</ambient><diffuse>0.18 0.25 0.45 1</diffuse></material>
        </visual>

        <!-- Torso / Gilet de sécurité haute visibilité (Jaune fluo EN ISO 20471) -->
        <visual name="worker_torso_vest">
          <pose>0 0 1.10 0 0 0</pose>
          <geometry><box><size>0.26 0.44 0.54</size></box></geometry>
          <material><ambient>0.85 0.95 0.05 1</ambient><diffuse>0.90 0.99 0.10 1</diffuse></material>
        </visual>

        <!-- Bandes rétroréfléchissantes horizontales sur gilet (Argenté) -->
        <visual name="worker_reflective_stripe_1">
          <pose>0 0 1.02 0 0 0</pose>
          <geometry><box><size>0.268 0.448 0.05</size></box></geometry>
          <material><ambient>0.92 0.94 0.96 1</ambient><diffuse>0.96 0.98 1.0 1</diffuse></material>
        </visual>
        <visual name="worker_reflective_stripe_2">
          <pose>0 0 1.16 0 0 0</pose>
          <geometry><box><size>0.268 0.448 0.05</size></box></geometry>
          <material><ambient>0.92 0.94 0.96 1</ambient><diffuse>0.96 0.98 1.0 1</diffuse></material>
        </visual>

        <!-- Tête de l'opérateur (Teinte de peau naturelle) -->
        <visual name="worker_head">
          <pose>0 0 1.50 0 0 0</pose>
          <geometry><sphere><radius>0.11</radius></sphere></geometry>
          <material><ambient>0.85 0.65 0.50 1</ambient><diffuse>0.90 0.70 0.55 1</diffuse></material>
        </visual>

        <!-- Casque de chantier de sécurité blanc (Protection EPI) -->
        <visual name="worker_hardhat_dome">
          <pose>0 0 1.58 0 0 0</pose>
          <geometry><sphere><radius>0.13</radius></sphere></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
        <visual name="worker_hardhat_brim">
          <pose>0.03 0 1.54 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
