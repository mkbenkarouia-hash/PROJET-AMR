<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="factory_workshop">

    <!-- ============================================================== -->
    <!--  ATELIER INDUSTRIEL FUBA - FABRICATION ET INSPECTION DE PCB   -->
    <!--  Projet RAIA 01.26 | Environnement Gazebo réaliste            -->
    <!--  Remplacement des 3 formes géométriques primitives            -->
    <!-- ============================================================== -->

    <!-- Optimisation graphique pour fluidité maximale sous WSL2 (FPS élevé) -->
    <scene>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>

    <!-- Plugin ROS2 Gazebo State pour contrôle d'entités dynamiques (/set_entity_state) -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <!-- Éclairage solaire autonome (sans ombres pour gain FPS) -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.85 0.85 0.88 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Éclairage d'ambiance d'atelier (néons industriels plafonniers) -->
    <light type="point" name="overhead_lamp_1">
      <cast_shadows>false</cast_shadows>
      <pose>-2 2 4.5 0 0 0</pose>
      <diffuse>0.5 0.52 0.55 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light type="point" name="overhead_lamp_2">
      <cast_shadows>false</cast_shadows>
      <pose>2 -2 4.5 0 0 0</pose>
      <diffuse>0.5 0.52 0.55 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Sol de l'atelier : Résine époxy industrielle grise -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.82 0.84 0.86 1</ambient>
            <diffuse>0.82 0.84 0.86 1</diffuse>
            <specular>0.3 0.3 0.32 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Physique ODE optimisée temps réel -->
    <physics type="ode">
      <real_time_update_rate>250.0</real_time_update_rate>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ============================================================== -->
    <!--  ENCLOS DE L'ATELIER (MURS PERIMETRIQUES 10m x 10m x 2.6m)     -->
    <!-- ============================================================== -->

    <!-- Mur Nord -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 1.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.25 2.6</size></box></geometry>
        </collision>
        <visual name="wall_face">
          <geometry><box><size>10 0.25 2.6</size></box></geometry>
          <material>
            <ambient>0.92 0.93 0.94 1</ambient>
            <diffuse>0.92 0.93 0.94 1</diffuse>
          </material>
        </visual>
        <visual name="baseboard">
          <pose>0 -0.13 -1.2 0 0 0</pose>
          <geometry><box><size>10 0.02 0.2</size></box></geometry>
          <material><ambient>0.25 0.28 0.32 1</ambient><diffuse>0.25 0.28 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Mur Sud -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 1.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.25 2.6</size></box></geometry>
        </collision>
        <visual name="wall_face">
          <geometry><box><size>10 0.25 2.6</size></box></geometry>
          <material>
            <ambient>0.92 0.93 0.94 1</ambient>
            <diffuse>0.92 0.93 0.94 1</diffuse>
          </material>
        </visual>
        <visual name="baseboard">
          <pose>0 0.13 -1.2 0 0 0</pose>
          <geometry><box><size>10 0.02 0.2</size></box></geometry>
          <material><ambient>0.25 0.28 0.32 1</ambient><diffuse>0.25 0.28 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Mur Est -->
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.25 10 2.6</size></box></geometry>
        </collision>
        <visual name="wall_face">
          <geometry><box><size>0.25 10 2.6</size></box></geometry>
          <material>
            <ambient>0.92 0.93 0.94 1</ambient>
            <diffuse>0.92 0.93 0.94 1</diffuse>
          </material>
        </visual>
        <visual name="baseboard">
          <pose>-0.13 0 -1.2 0 0 0</pose>
          <geometry><box><size>0.02 10 0.2</size></box></geometry>
          <material><ambient>0.25 0.28 0.32 1</ambient><diffuse>0.25 0.28 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Mur Ouest -->
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.25 10 2.6</size></box></geometry>
        </collision>
        <visual name="wall_face">
          <geometry><box><size>0.25 10 2.6</size></box></geometry>
          <material>
            <ambient>0.92 0.93 0.94 1</ambient>
            <diffuse>0.92 0.93 0.94 1</diffuse>
          </material>
        </visual>
        <visual name="baseboard">
          <pose>0.13 0 -1.2 0 0 0</pose>
          <geometry><box><size>0.02 10 0.2</size></box></geometry>
          <material><ambient>0.25 0.28 0.32 1</ambient><diffuse>0.25 0.28 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Piliers structuraux IPN de l'atelier -->
    <model name="pillar_nw">
      <static>true</static>
      <pose>-2.5 4.8 1.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 2.6</size></box></geometry>
          <material><ambient>0.28 0.35 0.42 1</ambient><diffuse>0.28 0.35 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_ne">
      <static>true</static>
      <pose>2.5 4.8 1.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 2.6</size></box></geometry>
          <material><ambient>0.28 0.35 0.42 1</ambient><diffuse>0.28 0.35 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_sw">
      <static>true</static>
      <pose>-2.5 -4.8 1.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 2.6</size></box></geometry>
          <material><ambient>0.28 0.35 0.42 1</ambient><diffuse>0.28 0.35 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_se">
      <static>true</static>
      <pose>2.5 -4.8 1.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 2.6</size></box></geometry>
          <material><ambient>0.28 0.35 0.42 1</ambient><diffuse>0.28 0.35 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!--  STATION 1 : SERIGRAPHIE & CHARGEMENT (MPM MOMENTUM II ELITE) -->
    <!--  Remplace l'ancien obstacle rectangulaire pcb_station_1        -->
    <!--  Photo Fig. 20 (page 43 du rapport RAIA)                      -->
    <!-- ============================================================== -->
    <model name="station_mpm_momentum_serigraphie">
      <static>true</static>
      <pose>2.8 2.2 0 0 0 -1.5708</pose>
      <link name="link">
        <!-- Boîte de collision globale exacte pour le LiDAR et la physique -->
        <collision name="collision_base">
          <pose>0 0 0.72 0 0 0</pose>
          <geometry><box><size>1.5 1.25 1.45</size></box></geometry>
        </collision>

        <!-- Bâti inférieur machine blanc industriel -->
        <visual name="base_chassis">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.5 1.2 0.9</size></box></geometry>
          <material><ambient>0.93 0.94 0.95 1</ambient><diffuse>0.93 0.94 0.95 1</diffuse></material>
        </visual>

        <!-- Capot supérieur avec chanfrein noir/anthracite -->
        <visual name="upper_hood">
          <pose>0 0 1.15 0 0 0</pose>
          <geometry><box><size>1.46 1.1 0.5</size></box></geometry>
          <material><ambient>0.15 0.17 0.2 1</ambient><diffuse>0.15 0.17 0.2 1</diffuse></material>
        </visual>

        <!-- Fenêtre d'inspection sérigraphie en verre teinté -->
        <visual name="inspection_glass">
          <pose>0 -0.56 1.15 0 0 0</pose>
          <geometry><box><size>1.05 0.03 0.32</size></box></geometry>
          <material><ambient>0.05 0.12 0.18 1</ambient><diffuse>0.05 0.12 0.18 1</diffuse><specular>0.8 0.8 0.9 1</specular></material>
        </visual>

        <!-- Bandeau d'accent bleu MPM -->
        <visual name="mpm_accent_stripe">
          <pose>0 -0.61 0.82 0 0 0</pose>
          <geometry><box><size>1.48 0.02 0.06</size></box></geometry>
          <material><ambient>0.05 0.3 0.65 1</ambient><diffuse>0.05 0.3 0.65 1</diffuse></material>
        </visual>

        <!-- Console opérateur latérale (bras support) -->
        <visual name="screen_arm">
          <pose>0.82 -0.2 1.05 0 0 0</pose>
          <geometry><box><size>0.2 0.06 0.06</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>

        <!-- Écran de contrôle MPM Momentum -->
        <visual name="operator_screen_frame">
          <pose>0.88 -0.45 1.25 0 0 0</pose>
          <geometry><box><size>0.48 0.04 0.38</size></box></geometry>
          <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material>
        </visual>
        <visual name="operator_screen_display">
          <pose>0.88 -0.48 1.25 0 0 0</pose>
          <geometry><box><size>0.44 0.01 0.34</size></box></geometry>
          <material><ambient>0.08 0.45 0.82 1</ambient><diffuse>0.08 0.45 0.82 1</diffuse><emissive>0.05 0.2 0.4 1</emissive></material>
        </visual>
        <visual name="keyboard_tray">
          <pose>0.88 -0.48 0.95 0 0 0</pose>
          <geometry><box><size>0.46 0.22 0.03</size></box></geometry>
          <material><ambient>0.3 0.32 0.35 1</ambient><diffuse>0.3 0.32 0.35 1</diffuse></material>
        </visual>

        <!-- Bouton Arrêt d'Urgence (E-stop) -->
        <visual name="estop_box">
          <pose>0.62 -0.62 0.88 0 0 0</pose>
          <geometry><box><size>0.08 0.04 0.08</size></box></geometry>
          <material><ambient>0.95 0.8 0.0 1</ambient><diffuse>0.95 0.8 0.0 1</diffuse></material>
        </visual>
        <visual name="estop_mushroom">
          <pose>0.62 -0.65 0.88 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.85 0.05 0.05 1</ambient><diffuse>0.85 0.05 0.05 1</diffuse></material>
        </visual>

        <!-- Colonne lumineuse Andon (Mât) -->
        <visual name="andon_pole">
          <pose>-0.65 0.4 1.6 0 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
        <!-- Andon Rouge -->
        <visual name="andon_red">
          <pose>-0.65 0.4 1.95 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.07</length></cylinder></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
        <!-- Andon Orange -->
        <visual name="andon_amber">
          <pose>-0.65 0.4 1.87 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.07</length></cylinder></geometry>
          <material><ambient>0.9 0.6 0.0 1</ambient><diffuse>0.9 0.6 0.0 1</diffuse></material>
        </visual>
        <!-- Andon Vert actif -->
        <visual name="andon_green">
          <pose>-0.65 0.4 1.79 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.07</length></cylinder></geometry>
          <material><ambient>0.1 0.9 0.2 1</ambient><diffuse>0.1 0.9 0.2 1</diffuse><emissive>0.2 0.8 0.3 1</emissive></material>
        </visual>

        <!-- Convoyeur d'interface de transfert PCB -->
        <visual name="pcb_input_slot">
          <pose>-0.76 0 0.85 0 0 0</pose>
          <geometry><box><size>0.03 0.4 0.1</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!--  STATION 2 : TESTEUR SONDES MOBILES & VISION IA (SPEA 4050)   -->
    <!--  Remplace l'ancien obstacle carré/rectangle pcb_station_2      -->
    <!--  Banc d'inspection optique temps réel YOLOv8 (rapport RAIA)    -->
    <!-- ============================================================== -->
    <model name="station_spea_4050_testeur_ia">
      <static>true</static>
      <pose>-2.8 2.2 0 0 0 -1.5708</pose>
      <link name="link">
        <!-- Boîte de collision globale pour physique et LiDAR -->
        <collision name="collision_base">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry><box><size>1.5 1.35 1.6</size></box></geometry>
        </collision>

        <!-- Bâti vertical principal SPEA 4050 blanc crème -->
        <visual name="spea_main_body">
          <pose>0 0 0.77 0 0 0</pose>
          <geometry><box><size>1.4 1.25 1.55</size></box></geometry>
          <material><ambient>0.94 0.95 0.96 1</ambient><diffuse>0.94 0.95 0.96 1</diffuse></material>
        </visual>

        <!-- Chambre centrale de test à sondes mobiles -->
        <visual name="test_chamber_recess">
          <pose>0 -0.55 0.8 0 0 0</pose>
          <geometry><box><size>1.05 0.16 0.65</size></box></geometry>
          <material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.12 0.14 0.16 1</diffuse></material>
        </visual>

        <!-- Fixture / Plateau de circuit imprimé sous test (vert PCB) -->
        <visual name="pcb_under_test">
          <pose>0 -0.45 0.65 0 0 0</pose>
          <geometry><box><size>0.6 0.35 0.03</size></box></geometry>
          <material><ambient>0.1 0.55 0.25 1</ambient><diffuse>0.1 0.55 0.25 1</diffuse></material>
        </visual>

        <!-- Pont de mesure robotisé (portique sondes volantes) -->
        <visual name="flying_probes_gantry">
          <pose>0 -0.45 0.95 0 0 0</pose>
          <geometry><box><size>0.85 0.05 0.05</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>

        <!-- Caméra industrielle d'inspection optique (IA YOLOv8) -->
        <visual name="vision_ai_camera">
          <pose>0 -0.45 1.05 0 0 0</pose>
          <geometry><box><size>0.08 0.1 0.1</size></box></geometry>
          <material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.1 0.1 0.12 1</diffuse></material>
        </visual>
        <visual name="camera_lens">
          <pose>0 -0.45 0.98 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.2 0.3 0.4 1</ambient><diffuse>0.2 0.3 0.4 1</diffuse></material>
        </visual>

        <!-- Grand écran principal de test SPEA 4050 -->
        <visual name="main_screen_frame">
          <pose>0 -0.48 1.38 0 0 0</pose>
          <geometry><box><size>0.78 0.04 0.48</size></box></geometry>
          <material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.1 0.1 0.12 1</diffuse></material>
        </visual>
        <visual name="main_screen_display">
          <pose>0 -0.51 1.38 0 0 0</pose>
          <geometry><box><size>0.74 0.01 0.44</size></box></geometry>
          <material><ambient>0.05 0.4 0.75 1</ambient><diffuse>0.05 0.4 0.75 1</diffuse><emissive>0.05 0.25 0.5 1</emissive></material>
        </visual>

        <!-- Écran secondaire supervision IA (Défauts YOLOv8 503/521/522) -->
        <visual name="aux_screen_frame">
          <pose>0.65 -0.38 1.35 0 0 0</pose>
          <geometry><box><size>0.36 0.04 0.32</size></box></geometry>
          <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material>
        </visual>
        <visual name="aux_screen_display">
          <pose>0.65 -0.41 1.35 0 0 0</pose>
          <geometry><box><size>0.32 0.01 0.28</size></box></geometry>
          <material><ambient>0.1 0.6 0.4 1</ambient><diffuse>0.1 0.6 0.4 1</diffuse><emissive>0.05 0.3 0.2 1</emissive></material>
        </visual>

        <!-- Colonne lumineuse Andon SPEA -->
        <visual name="andon_pole">
          <pose>-0.6 0.4 1.7 0 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
        <visual name="andon_red">
          <pose>-0.6 0.4 2.05 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.07</length></cylinder></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
        <visual name="andon_amber">
          <pose>-0.6 0.4 1.97 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.07</length></cylinder></geometry>
          <material><ambient>0.9 0.6 0.0 1</ambient><diffuse>0.9 0.6 0.0 1</diffuse></material>
        </visual>
        <visual name="andon_green">
          <pose>-0.6 0.4 1.89 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.07</length></cylinder></geometry>
          <material><ambient>0.1 0.9 0.2 1</ambient><diffuse>0.1 0.9 0.2 1</diffuse><emissive>0.2 0.8 0.3 1</emissive></material>
        </visual>

        <!-- Bouton Arrêt d'Urgence frontal -->
        <visual name="estop_box">
          <pose>-0.58 -0.64 0.9 0 0 0</pose>
          <geometry><box><size>0.08 0.04 0.08</size></box></geometry>
          <material><ambient>0.95 0.8 0.0 1</ambient><diffuse>0.95 0.8 0.0 1</diffuse></material>
        </visual>
        <visual name="estop_button">
          <pose>-0.58 -0.67 0.9 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.85 0.05 0.05 1</ambient><diffuse>0.85 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!--  STATION 3 : FOUR DE REFUSION & TRAITEMENT THERMIQUE (I.C.T)  -->
    <!--  Remplace l'ancienne station et complète la ligne FUBA         -->
    <!--  Four Lead-Free de durcissement et refusion (page 42 rapport)  -->
    <!-- ============================================================== -->
    <model name="station_ict_four_refusion">
      <static>true</static>
      <pose>2.8 -2.2 0 0 0 1.5708</pose>
      <link name="link">
        <!-- Collision englobante pour physique et LiDAR -->
        <collision name="collision_base">
          <pose>0 0 0.72 0 0 0</pose>
          <geometry><box><size>2.5 1.15 1.45</size></box></geometry>
        </collision>

        <!-- Bâti inférieur en acier lourd ivoire/blanc -->
        <visual name="lower_body">
          <pose>0 0 0.42 0 0 0</pose>
          <geometry><box><size>2.4 1.05 0.84</size></box></geometry>
          <material><ambient>0.92 0.93 0.94 1</ambient><diffuse>0.92 0.93 0.94 1</diffuse></material>
        </visual>

        <!-- Capot supérieur tunnel thermique bombé noir graphite -->
        <visual name="tunnel_hood">
          <pose>0 0 1.05 0 0 0</pose>
          <geometry><box><size>2.3 0.95 0.45</size></box></geometry>
          <material><ambient>0.16 0.18 0.22 1</ambient><diffuse>0.16 0.18 0.22 1</diffuse></material>
        </visual>

        <!-- Fentes de tunnel de convoyage (entrée / sortie) -->
