    </model>

    <!-- ============================================================== -->
    <!--  OBSTACLE FIXE : CHARIOT INDUSTRIEL DE MAINTENANCE TECHNIQUE   -->
    <!--  Implanté au carrefour central (x=0.0, y=0.65) entre ST1 et ST2 -->
    <!--  Valide la déviation autonome dynamique (contournement Nav2)     -->
    <!-- ============================================================== -->
    <model name="chariot_maintenance_fixe">
      <static>true</static>
      <pose>0.0 0.65 0 0 0 0</pose>
      <link name="link">
        <!-- Collision englobante solide détectée par le LiDAR 2D -->
        <collision name="cart_collision">
          <pose>0 0 0.42 0 0 0</pose>
          <geometry><box><size>0.54 0.54 0.84</size></box></geometry>
        </collision>

        <!-- 4 Roues industrielles pivotantes au sol -->
        <visual name="cart_wheel_fl">
          <pose>0.22 0.22 0.04 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <visual name="cart_wheel_fr">
          <pose>0.22 -0.22 0.04 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <visual name="cart_wheel_rl">
          <pose>-0.22 0.22 0.04 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <visual name="cart_wheel_rr">
          <pose>-0.22 -0.22 0.04 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>

        <!-- Plateau inférieur (Gris anthracite métallisé) -->
        <visual name="cart_bottom_shelf">
          <pose>0 0 0.10 0 0 0</pose>
          <geometry><box><size>0.50 0.50 0.04</size></box></geometry>
          <material><ambient>0.25 0.27 0.30 1</ambient><diffuse>0.30 0.32 0.35 1</diffuse></material>
        </visual>

        <!-- 4 Montants verticaux d'angle tubulaires (Chrome/Aluminium) -->
        <visual name="cart_post_fl">
          <pose>0.23 0.23 0.44 0 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.72</length></cylinder></geometry>
          <material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.85 0.87 0.90 1</diffuse></material>
        </visual>
        <visual name="cart_post_fr">
          <pose>0.23 -0.23 0.44 0 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.72</length></cylinder></geometry>
          <material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.85 0.87 0.90 1</diffuse></material>
        </visual>
        <visual name="cart_post_rl">
          <pose>-0.23 0.23 0.44 0 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.72</length></cylinder></geometry>
          <material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.85 0.87 0.90 1</diffuse></material>
        </visual>
        <visual name="cart_post_rr">
          <pose>-0.23 -0.23 0.44 0 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.72</length></cylinder></geometry>
          <material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.85 0.87 0.90 1</diffuse></material>
        </visual>

        <!-- Étagère intermédiaire -->
        <visual name="cart_mid_shelf">
          <pose>0 0 0.44 0 0 0</pose>
          <geometry><box><size>0.48 0.48 0.02</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.35 0.35 0.40 1</diffuse></material>
        </visual>

        <!-- Caisse à outils rouge atelier sur étagère intermédiaire -->
        <visual name="cart_toolbox">
          <pose>0.05 0.05 0.51 0 0 0.2</pose>
          <geometry><box><size>0.26 0.18 0.12</size></box></geometry>
          <material><ambient>0.8 0.15 0.1 1</ambient><diffuse>0.9 0.2 0.15 1</diffuse></material>
        </visual>

        <!-- Plateau supérieur de travail (Bleu industriel avec rebord) -->
        <visual name="cart_top_tray">
          <pose>0 0 0.80 0 0 0</pose>
          <geometry><box><size>0.52 0.52 0.04</size></box></geometry>
          <material><ambient>0.10 0.35 0.65 1</ambient><diffuse>0.15 0.45 0.80 1</diffuse></material>
        </visual>

        <!-- Poignée ergonomique de poussée du chariot -->
        <visual name="cart_handle">
          <pose>-0.28 0 0.82 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.45</length></cylinder></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>

        <!-- Signalisation rayures de danger jaune sur le flanc -->
        <visual name="cart_hazard_strip">
          <pose>0 0.262 0.79 0 0 0</pose>
          <geometry><box><size>0.50 0.005 0.035</size></box></geometry>
          <material><ambient>0.95 0.80 0.05 1</ambient><diffuse>0.98 0.85 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!--  OBSTACLE MOBILE : OPÉRATEUR D'ATELIER (EMPLOYEUR / PIÉTON)   -->
    <!--  Positionné sur l'allée centrale de transit (y = -1.60)         -->
    <!--  Traverse la trajectoire de l'AMR en cours de navigation ST0->ST1-->
    <!-- ============================================================== -->
    <model name="human_worker_pedestrian">
      <static>false</static>
      <pose>1.5 -1.6 0 0 0 3.14159</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <!-- Collision cylindrique complète pour réflexion LiDAR fiable -->
        <collision name="worker_body_collision">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.24</radius>
              <length>1.70</length>
            </cylinder>
          </geometry>
        </collision>

        <!-- Chaussures de sécurité (Cuir noir coquées) -->
        <visual name="worker_boot_left">
          <pose>0.04 0.11 0.06 0 0 0</pose>
          <geometry><box><size>0.22 0.11 0.12</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
