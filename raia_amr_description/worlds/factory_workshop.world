          <pose>-0.17 0.096 0.30 0 0 0</pose>
          <geometry><box><size>0.012 0.003 0.05</size></box></geometry>
          <material>
            <ambient>0.45 0.47 0.50 1</ambient>
            <diffuse>0.50 0.52 0.55 1</diffuse>
          </material>
        </visual>

        <!-- Logo MiR — Triangle / Point cyan caractéristique sur le i -->
        <visual name="mir_logo_cyan_dot">
          <pose>-0.17 0.096 0.335 0 0 0</pose>
          <geometry><box><size>0.014 0.004 0.014</size></box></geometry>
          <material>
            <ambient>0.0 0.65 0.85 1</ambient>
            <diffuse>0.0 0.75 0.95 1</diffuse>
