          </material>
        </visual>

        <!-- Façade avant blanche avec rebord biseauté -->
        <visual name="mir_front_bezel">
          <pose>0 0.092 0.255 0 0 0</pose>
          <geometry><box><size>0.60 0.006 0.33</size></box></geometry>
          <material>
            <ambient>0.97 0.97 0.98 1</ambient>
            <diffuse>0.99 0.99 1.0 1</diffuse>
          </material>
        </visual>

        <!-- Cavité / Poignée centrale encastrée (Gris clair) -->
        <visual name="mir_center_pocket">
          <pose>0.05 0.094 0.25 0 0 0</pose>
          <geometry><box><size>0.22 0.005 0.09</size></box></geometry>
          <material>
            <ambient>0.82 0.83 0.85 1</ambient>
